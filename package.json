{
  "name": "magpie-claude-science",
  "version": "0.1.6",
  "description": "Magpie Agent and middleware with an explicit local service installer for Claude Science",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node test/integration.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/release-check.mjs"
  },
  "magpie": {
    "agent": "./src/agent.js",
    "middleware": "./src/middleware.js",
    "options": {
      "agent": "claude-science",
      "model": "codex/gpt-6-luna"
    },
    "icon": "data:image/png;base64,"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "bin": {
    "magpie-claude-science": "src/cli.js"
  },
  "files": [
    "src/*.js",
    "src/*.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/operations.zh-CN.md",
    "docs/publishing.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guuuu233/magpie-claude-science.git"
  },
  "homepage": "https://github.com/Guuuu233/magpie-claude-science#readme",
  "bugs": {
    "url": "https://github.com/Guuuu233/magpie-claude-science/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/runtime.js"
}
